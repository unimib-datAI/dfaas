# Binaries and files that should not be in the repository at all!
*.exe
*.exe~
*.dll
*.so
*.dylib
*.swp
*.pem
__pycache__
.idea
.DS_Store

# Ignore custom Ansible inventory files.
**/inventory.yaml

# Custom ignores
emulator/containernet
emulator/openflow
framework/outputs/**
!framework/outputs/**/.gitkeep
simulation/outputs/**
!simulation/outputs/**/.gitkeep

# Ignore Python virtual environment directories.
*.env/
env/

# Ignore generated files by
# metrics_predictions/samples_generator/samples-generator.py and
# samples-generator-profiler.py Python scripts.
metrics_predictions/output*/**

# Ignore HAProxy generated configurations.
/dfaasagent/haproxy*.cfg

# Ignore custom DFaaS configurations.
/dfaasagent/*.env

# Ignore generated binaries.
/dfaasagent/dfaasagent
/k8s/scripts/libp2p-peer-id/libp2p-peer-id
/k8s/scripts/rl-model-proxy/rl-model-proxy
/k8s/scripts/haproxy-metrics-exporter/haproxy-metrics-exporter

# Ignore custom config. for set-latency script.
/k8s/scripts/set-latency/*.yaml

# Ignore log files.
*.log

# Ignore generated files from experiments.
/data
*.png
*.jpg
*.csv
*.gz
*.html
*.pdf
*.tar
